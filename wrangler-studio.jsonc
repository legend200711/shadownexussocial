{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ════════════════════════════════════════════════════════════════════════════
  // Shadow Nexus Social — CloudStream Worker  (Stage 2 Hardened)
  // Provides server-side 24-hour broadcast scheduling and control
  //
  // ── DEPLOYMENT ──────────────────────────────────────────────────────────────
  // Deploy this Worker + Durable Object with:
  //
  //   npx wrangler deploy --config wrangler-studio.jsonc
  //
  // NOTE: GitHub Actions / Firebase Hosting does NOT deploy Cloudflare Workers.
  //       You must run the above command manually or via a dedicated CF deploy
  //       step whenever cloudstream-worker.js changes.
  //
  // ── FIRST-TIME SETUP ────────────────────────────────────────────────────────
  // 1. Set secrets (once per environment, not committed to git):
  //      npx wrangler secret put FIREBASE_API_KEY  --config wrangler-studio.jsonc
  //      npx wrangler secret put STREAM_SECRET     --config wrangler-studio.jsonc
  //
  // 2. If the KV namespace does not yet exist:
  //      npx wrangler kv namespace create cloudStreamKV --config wrangler-studio.jsonc
  //    Then update the "id" field below with the printed namespace ID.
  //
  // ── REQUIRED BINDINGS ───────────────────────────────────────────────────────
  //   cloudStreamKV  — KV namespace (stream state, music state, media metadata, viewer presence)
  //   CloudStreamDO  — Durable Object (CloudStreamScheduler class)
  //   FIREBASE_API_KEY  (secret) — Firebase Web API key for server-side token verification
  //   STREAM_SECRET     (secret) — Optional signing secret for stream tokens
  //
  // ════════════════════════════════════════════════════════════════════════════

  "name": "snx-cloudstream",
  "main": "cloudstream-worker.js",
  "compatibility_date": "2025-01-01",
  "account_id": "f276c4406b82d3c1e35efed1ef486235",

  // Workers.dev endpoint — immediately reachable without a custom domain.
  "workers_dev": true,

  // ── KV Namespace: stream state, music state, media metadata, viewer presence ──
  "kv_namespaces": [
    {
      "binding": "cloudStreamKV",
      "id": "f0d77e4a5397436ba8e01ebe2fd4fe9f"
    }
  ],

  // ── Durable Objects: persistent 24-hour channel clock + alarms ──
  // One DO instance per channel: idFromName("{streamId}_music")
  "durable_objects": {
    "bindings": [
      {
        "name": "CloudStreamDO",
        "class_name": "CloudStreamScheduler"
      }
    ]
  },

  // ── Migrations ──
  // IMPORTANT: Do NOT add new migration tags after v1 has been deployed.
  // v1 is the production Durable Object class for CloudStreamScheduler.
  // Adding a new tag would create a NEW DO class and lose all active channel state.
  // Only add a new migration tag if you are intentionally creating a new DO class name.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CloudStreamScheduler"]
    }
  ],

  // ── Non-secret config vars ──
  "vars": {
    "SNX_ORIGIN":           "https://shadownexussocial.online",
    "SNX_ORIGIN2":          "https://chrislegendofshadows.com",
    "FIREBASE_PROJECT_ID":  "horr-a08f4",
    "WORKER_ENV":           "production"
  }

  // ── Secrets (NEVER commit values — set via wrangler CLI) ──
  //   STREAM_SECRET    — optional signing secret for stream tokens
  //   FIREBASE_API_KEY — Firebase Web API key for server-side REST (accounts:signUp, accounts:lookup)
  //
  // The upload-worker (wrangler.jsonc / yellow-term-11e6) owns the R2 BUCKET binding.
  // Media R2 deletions are proxied through the upload-worker's /r2/delete endpoint.
}
