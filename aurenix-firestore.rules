/**
 * AURENIX (remix-studio-4bf8a) — Firestore Security Rules
 *
 * DEPLOY TARGET:  Firebase project remix-studio-4bf8a
 * DEPLOY COMMAND: firebase use remix-studio-4bf8a && firebase deploy --only firestore:rules
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * WHY THIS FILE EXISTS
 * ─────────────────────────────────────────────────────────────────────────────
 * The Shadow Nexus Social 24-Hour TV adapter (snx-ch-adapter.js) queries the
 * network_channels collection on remix-studio-4bf8a using a Firestore client
 * that does NOT carry any Firebase Auth token for this project.
 *
 * Authentication for Shadow Nexus Social comes from the primary project
 * (horr-a08f4) via window._snxAuth / window._snxCurrentUser.  No user is
 * ever signed into remix-studio-4bf8a.
 *
 * If the Firestore rules on remix-studio-4bf8a require  request.auth != null
 * for network_channels reads, every query is denied with PERMISSION_DENIED,
 * resulting in:
 *   • "Connecting…" / "No channels available"
 *   • Empty TV Guide / "Up Next: Loading…"
 *   • Console: [24TV ERROR] network_channels query failed. code: permission-denied
 *
 * FIX: deploy these rules to remix-studio-4bf8a so network_channels is
 * publicly readable (channel listings are not sensitive data).
 * ─────────────────────────────────────────────────────────────────────────────
 */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── network_channels — publicly readable (channel listing for 24-Hour TV) ──
    // Shadow Nexus Social reads this collection without auth context.
    // Only the Founder account should be able to write.
    match /network_channels/{channelId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'christijerina46@gmail.com';
    }

    // ── network_state — live channel playback state ──
    // Readable by any client (required for viewer sync).
    // Writes are controlled by the Cloudflare Worker (service-account auth).
    match /network_state/{channelId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── network_media — media library ──
    match /network_media/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'christijerina46@gmail.com';
    }

    // ── All other documents — deny by default ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
