{
  "rules": {

    "cohosts": {
      "$liveId": {

        "settings": {
          ".read":  "auth != null",
          ".write": "auth != null"
        },

        "requests": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        },

        "active": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        },

        "removed": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        }
      }
    },

    "liveRooms": {
      ".read":   "auth != null",
      "$roomId": {
        ".write": "auth != null && (root.child('liveRooms').child($roomId).child('hostId').val() == auth.uid || !root.child('liveRooms').child($roomId).exists())"
      }
    },

    "liveSignaling": {
      "$roomId": {
        "$viewerId": {
          ".read":  "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "livePresence": {
      "$roomId": {
        "$sessionId": {
          ".read":  "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "liveChats": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "liveSignal": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "liveConnections": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "studioLiveConnections": {
      "$hostUid": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "guestRequests": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "guestSignaling": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "liveGuests": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "guestViewerSignaling": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "stormRooms": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "supportRooms": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "presence": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "nexusViewers": {
      "$channelId": {
        ".read":  "auth != null",
        "$sessionId": {
          ".write": "auth != null"
        }
      }
    },


    "userLive": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "users": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }

  }
}
