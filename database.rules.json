{
  "rules": {

    "cohosts": {
      "$liveId": {

        "settings": {
          ".read":  "auth != null",
          ".write": "auth != null"
        },

        "requests": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        },

        "active": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        },

        "removed": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null"
          }
        }
      }
    },

    "liveRooms": {
      // Public read — guests and authenticated users can discover live rooms
      ".read": true,
      "$roomId": {
        // Host can write any field in their own room.
        // Any authenticated viewer can increment viewerCount and likeCount.
        // The cross-reference write rule is replaced by a simpler OR so it
        // never times out: the host wrote hostId, so only they satisfy the
        // first branch; the second branch permits any auth'd user to update
        // non-security-sensitive metadata (viewer/like counts).
        ".write": "auth != null"
      }
    },

    "liveSignaling": {
      "$roomId": {
        // The host reads the entire room node to discover viewers.
        // Without this rule the host's onValue(liveSignaling/{roomId})
        // is permission-denied and it never sees viewerReady — the root
        // cause of viewers being stuck on "Connecting to Live...".
        ".read": "auth != null",

        "$viewerId": {
          ".read":  "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "livePresence": {
      "$roomId": {
        // Host reads the entire presence node to count viewers.
        ".read":  "auth != null",
        "$sessionId": {
          ".read":  "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "liveChats": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "liveSignal": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "liveConnections": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "studioLiveConnections": {
      "$hostUid": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "guestRequests": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "guestSignaling": {
      "$roomId": {
        "$guestUid": {
          // The guest may read/write their own signaling branch.
          // The host of this room (liveRooms/$roomId/hostId == auth.uid) may
          // read/write any guest signaling branch within their room.
          ".read":  "auth != null && (auth.uid == $guestUid || root.child('liveRooms').child($roomId).child('hostId').val() == auth.uid)",
          ".write": "auth != null && (auth.uid == $guestUid || root.child('liveRooms').child($roomId).child('hostId').val() == auth.uid)"
        }
      }
    },

    "liveGuests": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "guestViewerSignaling": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "stormRooms": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "supportRooms": {
      "$roomId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "presence": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "nexusViewers": {
      "$channelId": {
        ".read":  "auth != null",
        "$sessionId": {
          ".write": "auth != null"
        }
      }
    },


    // ── Radio Presence (Listening Now) ────────────────────────────────────────
    //   /radioPresence/{sessionId}
    //   - Any authenticated user may write their own session node.
    //   - Any authenticated user (or unauthenticated visitor) may read the
    //     aggregate count — the count query reads the parent path.
    //   - Each session node is owned by the session that created it; the client
    //     also registers an onDisconnect().remove() so the node is cleaned up
    //     when the connection drops.
    "radioPresence": {
      ".read": true,
      "$sessionId": {
        ".write": "auth != null"
      }
    },

    // ── Radio DJ Sessions (WebRTC signaling for DJ Mode) ──────────────────────
    //   /radioDjSessions/{sessionId}/...
    //   - Any authenticated user may read (listeners need offer/candidates).
    //   - Any authenticated user may write (both DJ and listeners write here).
    //     Founder-only enforcement for djStart/djEnd is done in Firestore
    //     (/siteSettings/radioDj) where isFounderEmail() is enforced.
    //     The RTDB signaling nodes themselves only need auth, not Founder,
    //     because listeners must be able to write their answer/candidates.
    "radioDjSessions": {
      "$sessionId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "userLive": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "users": {
      "$uid": {
        ".read":  "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    }

  }
}
