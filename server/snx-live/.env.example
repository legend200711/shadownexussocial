# Shadow Nexus Live Media Server — environment variables
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to git.

# ── Server binding ────────────────────────────────────────────────────────────
# IP the server listens on. Use 0.0.0.0 to bind all interfaces.
SNX_LISTEN_IP=0.0.0.0

# Port for the HTTP/WebSocket signaling server.
SNX_PORT=3000

# ── mediasoup announced IP ────────────────────────────────────────────────────
# Public IP address of this VPS — the address mediasoup announces in SDP.
# Must be a real publicly-routable IPv4 address.
MEDIASOUP_ANNOUNCED_IP=YOUR_SERVER_PUBLIC_IP

# mediasoup RTP/UDP port range — these ports must be open in your firewall.
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=59999

# ── Authentication ────────────────────────────────────────────────────────────
# Shared secret used by the Cloudflare Worker to sign short-lived SNX Live tokens.
# Must match SNX_MEDIA_SERVER_SECRET in Cloudflare Worker secrets.
# Use a long random string: openssl rand -hex 32
SNX_TOKEN_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# ── coturn shared secret (for /snx-live/turn credential generation) ───────────
# Must match the use-auth-secret / static-auth-secret in your coturn config.
# Use a long random string: openssl rand -hex 32
# NOTE: This value is also stored as SNX_TURN_SECRET in the Cloudflare Worker.
COTURN_SHARED_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# ── TURN server public hostnames / ports ─────────────────────────────────────
COTURN_HOST=turn.yourdomain.com
COTURN_PORT=3478
COTURN_TLS_PORT=5349
