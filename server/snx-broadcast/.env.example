# Shadow Nexus Broadcast Engine — Stage 4C
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to git.
#
# Quick setup:
#   1. cp .env.example .env
#   2. Set SNX_TOKEN_SECRET  (openssl rand -hex 32)
#   3. Set FIREBASE_SERVICE_ACCOUNT (path to secrets/firebase-service-account.json)
#   4. Leave all other values at their defaults for a standard VPS deployment

# ── Server ────────────────────────────────────────────────────────────────────
# Port for the HTTP control API.
# The service binds to 127.0.0.1 only — NOT exposed publicly.
# External access is via Cloudflare Tunnel → localhost:3100.
PORT=3100
SNX_BROADCAST_PORT=3100

# ── Authentication ────────────────────────────────────────────────────────────
# Shared secret for SNX session tokens (HMAC-SHA256).
#
# This MUST match SNX_MEDIA_SERVER_SECRET in the Cloudflare Worker.
# The same secret is used on both ends of the token handshake:
#
#   Founder browser
#     → Cloudflare Worker (verifies Firebase token, issues signed SNX token)
#       → snx-broadcast (verifies SNX token with this secret)
#
# Generate a strong secret:
#   openssl rand -hex 32
#
# DO NOT use the placeholder below in production.
SNX_TOKEN_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# ── Firebase Admin ────────────────────────────────────────────────────────────
# Path to the Firebase service account JSON file (relative to WorkingDirectory).
#
# How to obtain:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
#
# Placement on VPS:
#   /opt/snx-broadcast/secrets/firebase-service-account.json
#   chmod 640  (readable only by snx-broadcast service user)
#
# NEVER commit this file to git.
# NEVER print or log its contents.
FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Override the ffmpeg binary path if not on $PATH.
# Leave empty to use system ffmpeg (/usr/bin/ffmpeg after apt install ffmpeg).
FFMPEG_PATH=/usr/bin/ffmpeg

# Override font file path for drawtext title overlays.
# Ubuntu 24.04: DejaVu is installed by default via ffmpeg dependencies.
# Leave empty to use the default path below.
FFMPEG_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ── Broadcast state persistence ───────────────────────────────────────────────
# Path to a JSON file that persists engine state across restarts.
# Contains only safe metadata (timestamps, destination names) — NO stream keys.
# Set to empty string to disable.
BROADCAST_STATE_FILE=./broadcast-state.json

# ── Development / Testing ─────────────────────────────────────────────────────
# Set to "true" to enable dry-run mode:
#   - No FFmpeg process spawned
#   - No Firestore destination reads
#   - Timeline + auth logic still executes
# Always false in production.
BROADCAST_DRY_RUN=false

# ── RTMP Destinations ─────────────────────────────────────────────────────────
# Destinations are NOT stored here.
# They are managed via the Shadow Nexus Broadcast Studio (Studio → BROADCAST tab)
# and persisted in Firestore /broadcastDestinations.
# Stream keys are stored server-side in Firestore only — never in .env or Git.
#
# Example Firestore document (/broadcastDestinations/{auto-id}):
#   name:      "YouTube"
#   serverUrl: "rtmps://a.rtmps.youtube.com/live2"
#   streamKey: "<your-stream-key>"   ← Founder-only read
#   enabled:   true
